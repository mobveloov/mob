# Motor de integração (Sistema A + Sistema B). Integração OPCIONAL: o painel funciona sem ela.
# No SaaS as credenciais vêm POR EMPRESA em cada chamada (veja docs/CONTRATO_MOTOR.md).
# Estas variáveis servem só para uma empresa de teste (empresaDoEnv) e para o servidor HTTP.
# NUNCA coloque valores reais aqui nem faça commit do .env.

# --- Servidor HTTP do motor (opcional) ---
MOTOR_PORTA=
MOTOR_HOST=
# Obrigatório se MOTOR_HOST não for 127.0.0.1
MOTOR_TOKEN=

# --- Sistema A (API de integração v2 documentada) ---
# Endereço da API, terminando em /api/v2/integracao
SISTEMA_A_API_URL=
# Chave da API (painel do Sistema A > Integrações). Vai no cabeçalho api-key.
SISTEMA_A_API_KEY=
# Usuário e senha de integração (Basic Auth). O Sistema A pede os dois junto com a chave.
SISTEMA_A_USUARIO=
SISTEMA_A_SENHA=
# Número do motivo usado quando o painel cancela sem escolher motivo
SISTEMA_A_MOTIVO_CANCELAMENTO_ID=

# --- Sistema B (sem API pública: usa o painel web com a sua sessão) ---
# Endereço do painel web (pasta onde ficam as páginas .php)
SISTEMA_B_PAINEL_URL=
# Endereço da API do app do passageiro (usado para categorias)
SISTEMA_B_APP_API_URL=
# Cookie PHPSESSID de uma sessão SUA no painel do Sistema B (vence quando a sessão fecha)
SISTEMA_B_COOKIE=
# Id da cidade no Sistema B (para categorias, filtro e criar corrida)
SISTEMA_B_CIDADE_ID=

# --- Testes contra as APIs reais (só leitura) ---
MOTOR_TESTE_REAL=
