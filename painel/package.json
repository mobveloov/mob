{
  "name": "mob-painel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/servidor/index.ts",
    "dev:web": "vite",
    "dev:apps": "vite --config vite.apps.config.ts",
    "build:apps": "vite build --config vite.apps.config.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/servidor/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "empresa:importar": "tsx src/servidor/cli-importar-empresa.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
