# Copie para painel/.env e preencha. NUNCA coloque valores reais neste arquivo nem faça commit do .env.
# As credenciais dos sistemas de origem e as chaves de IA de CADA EMPRESA ficam na tela Integrações (guardadas em dados/,
# fora do Git). Aqui ficam só as configurações da PLATAFORMA (dona do SaaS).

# --- Servidor ---
PAINEL_API_PORTA=8787
# Pasta dos dados das empresas (marca, usuários, credenciais, planilhas). Padrão: painel/dados
DADOS_DIR=
# Banco do painel (SQLite, roda junto). Vazio = DADOS_DIR/painel.db
BANCO_ARQUIVO=
# Segredo da sessão (mínimo 32 caracteres). Sem ele, o painel gera um e guarda em DADOS_DIR.
SESSAO_SEGREDO=

# --- IA (chaves da plataforma; cada empresa pode ter as suas em Integrações) ---
ANTHROPIC_API_KEY=
# Uma ou mais chaves da Groq, separadas por vírgula
GROQ_API_KEYS=
OPENAI_API_KEY=
GEMINI_API_KEY=
# false = cada empresa precisa ter a própria chave
IA_USAR_CHAVES_DA_PLATAFORMA=true

# Qual IA em cada caso (provedor:modelo, em ordem; a próxima é o plano B). Vazio = padrão.
# Padrões:
#   IA_ROTA_RELATORIO=anthropic:claude-sonnet-5-5,groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash
#   IA_ROTA_CHAT=groq:openai/gpt-oss-120b,anthropic:claude-haiku-5-5,gemini:gemini-2.5-flash
#   IA_ROTA_CLASSIFICACAO=groq:openai/gpt-oss-120b,anthropic:claude-haiku-5-5
#   IA_ROTA_VOZ=gemini:gemini-2.5-flash-preview-tts
IA_ROTA_RELATORIO=
IA_ROTA_CHAT=
IA_ROTA_CLASSIFICACAO=
IA_ROTA_VOZ=

# --- Motor ---
# Caminho do motor (padrão: ../motor/src/index.ts). Só mude se o motor estiver em outro lugar.
MOTOR_CAMINHO=

# --- WhatsApp (bot e CRM) ---
# Servidor Evolution API da plataforma. Vazio: o bot e o CRM rodam no modo simulado.
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_TOKEN=
# De quanto em quanto tempo o bot confere o status das corridas (segundos).
BOT_STATUS_SEGUNDOS=
# Endereço público do painel (usado nos links e no webhook do bot).
PUBLICO_URL=
# Só para testes: deixa o CRM usar uma Evolution API em endereço local.
CRM_PERMITIR_URL_LOCAL=

# --- Endereços e rota (opcional, veja docs/ENDERECOS.md) ---
# Pasta da base pública de endereços do IBGE (CNEFE), com _casas/<UF>.tsv.gz.
CNEFE_DIR=
# Servidor de rotas OSRM (distância pelas ruas). Vazio: linha reta × 1,3.
OSRM_URL=

# --- Apps do passageiro e do motorista (veja docs/APPS.md) ---
# Só em desenvolvimento: devolve o código de login na resposta (nunca vale com NODE_ENV=production).
APPS_MOSTRAR_CODIGO=
# Segundos que o motorista tem para aceitar a chamada (padrão 20) e raio da oferta em km (padrão 20).
APPS_OFERTA_SEGUNDOS=
APPS_RAIO_KM=
# Tamanho máximo do áudio do chat, em KB (padrão 1024).
APPS_AUDIO_MAX_KB=
# Push: conta de serviço do Firebase DA EMPRESA (caminho do JSON), uma variável por empresa.
# Ex.: FIREBASE_SERVICO_EXEMPLO=/segredos/exemplo-firebase.json  (ou o arquivo DADOS_DIR/empresas/<id>/apps/firebase-servico.json)
FIREBASE_SERVICO_EXEMPLO=
